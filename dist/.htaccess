# AssistLane Global static HTML site
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# BEGIN generated legacy dist aliases
RewriteCond %{THE_REQUEST} \s+(?:https?://[^/\s]+)?/+(?:dist/)+index\.html(?:[?\s]) [NC]
RewriteRule ^ https://www.assistlaneglobal.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s+(?:https?://[^/\s]+)?/+(?:dist/)+(contact)\.html(?:[?\s]) [NC]
RewriteRule ^ https://www.assistlaneglobal.com/contact-us [R=301,L]
RewriteCond %{THE_REQUEST} \s+(?:https?://[^/\s]+)?/+(?:dist/)+(services|accounting-bookkeeping|administrative-support|customer-support|crm-lead-operations|marketing-content|seo-wordpress|research-data-support|recruiting-people-operations|workflow-automation|ecommerce-operations|mobile-app-development|website-development|industries|industry-finance|industry-real-estate|industry-ecommerce|industry-agencies-publications|industry-ai-technology|industry-professional-services|industry-healthcare|industry-legal|industry-construction-field-services|industry-nonprofits-membership|industry-startups-small-business|how-it-works|about|trust|privacy-policy|404)\.html(?:[?\s]) [NC]
RewriteRule ^ https://www.assistlaneglobal.com/%1 [R=301,L]
# END generated legacy dist aliases

# Preserve contact links after renaming the public page. THE_REQUEST excludes
# the internal rewrite of /contact-us to its existing contact.html file.
RewriteCond %{THE_REQUEST} \s+(?:https?://[^/\s]+)?/+(?:(?:dist/)*(?:contact(?:\.html|/)?|contact-us(?:\.html|/))|(?:dist/)+contact-us)(?:[?\s]) [NC]
RewriteRule ^ https://www.assistlaneglobal.com/contact-us [R=301,L]

# THE_REQUEST prevents a clean URL's internal .html rewrite from redirecting again.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} \s/+(?:dist/)?index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^index(?:\.html)?$ https://www.assistlaneglobal.com/ [R=301,L]

# Check the requested filename, not a subsequent internal 404 document.
RewriteCond %{THE_REQUEST} \s/+(?:dist/)?([a-z0-9-]+)\.html(?:[?\s]) [NC]
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^(?:dist/)?([a-z0-9-]+)\.html$ https://www.assistlaneglobal.com/$1 [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ https://www.assistlaneglobal.com/$1 [R=301,L]

# Keep the preferred hostname on every page, preserving its path and query.
RewriteCond %{HTTP_HOST} ^assistlaneglobal\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://www.assistlaneglobal.com%{REQUEST_URI} [R=301,L,NE]

# Serve the existing file while keeping the browser URL extensionless.
RewriteRule ^contact-us$ contact.html [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# Do not expose hidden files or repository metadata.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
